# Everything is ignored, except the code behind the figures and the small inputs it reads (listed below).
# To track a new file, add a "!" line for it.
*
!*/
renv/library/
renv/staging/

!/.gitignore
!/.gitattributes
!/README.md
!/A1 Analysis.Rproj
!/.Rprofile
!/renv.lock
